---
import { Font } from 'astro:assets'
import { Schema } from 'astro-seo-schema'
import { buildJsonLd } from '@/lib/schema'
import { configSite } from '@/lib/site.config'
import globalCSS from '@/styles/global.css?inline'

const {
  title,
  description,
  canonical = Astro.url.href,
  schemas = [],
  breadcrumbs,
  ogImage = '/images/astro-social.jpg',
  noindex = false,
} = Astro.props

const schemaJsonLd = buildJsonLd({
  url: canonical,
  title,
  description,
  schemas,
  breadcrumbs,
})

const siteTitle = `${title} | ${configSite.name}`
const ogImageUrl = new URL(ogImage, configSite.url).toString()
const ogImageAlt = 'Imagen para la plantilla de Astro como Socil media'
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Datos del sitio -->
<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={`${canonical}/`} />

<meta name="author" content={configSite.author} />
<meta name="theme-color" content="#faf0e6" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Carga de la fuente de astro.config.ts -->
<Font cssVariable="--font-poppins" />

<!-- Carga el CSS generado en linea para evitar FOUC (Flash Of Unstyled Content)-->
<style set:html={globalCSS}></style>

<!-- Social Media Image 1200x630 recomendada -->
<meta property="og:url" content={canonical} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={configSite.name} />
<meta property="og:locale" content={configSite.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@bmmedina99" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon-96x96.png?v=261108" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=261108" />
<link rel="shortcut icon" href="/favicon.ico?v=261108" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=261108" />
<meta name="apple-mobile-web-app-title" content="AstroKit Template" />
<link rel="manifest" href="/site.webmanifest?v=261108" />

<!-- Configura el schema según el tipo de sitio: https://schema.org/docs/full.html | src/lib/schema -->
<Schema item={schemaJsonLd as any} />
