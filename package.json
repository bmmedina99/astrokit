{
  "name": "astrokit",
  "description": "Plantilla de Astro para crear sitios web estáticos rápidos; optimizada para SEO y accesibilidad, preconfigurada con TailwindCSS y TypeScript.",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/astrokit.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/astrokit/issues"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "7.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.5.7",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.15.0"
}
